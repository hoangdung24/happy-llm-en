---
// Starlight's default <head> emits the charset meta, viewport, and theme script.
// Render it, then add our font preload alongside it.
import Default from '@astrojs/starlight/components/Head.astro';
import woff2 from '@fontsource-variable/mulish/files/mulish-latin-wght-normal.woff2?url';
---

<Default><slot /></Default>

<link
	rel="preload"
	href={woff2}
	as="font"
	type="font/woff2"
	crossorigin="anonymous"
/>

<script is:inline>
	// Register the Workbox service worker (see scripts/build-sw.mjs).
	// Only active in production builds; `astro dev` does not serve /sw.js.
	if ('serviceWorker' in navigator) {
		window.addEventListener('load', () => {
			navigator.serviceWorker.register('/sw.js').catch(() => {});
		});

		// Cloudflare redirects /foo/index.html to /foo/, so the precache manifest
		// and the cached copy of a navigated URL use different keys. Turn any
		// ".html" URL into its canonical directory form before the SW sees it.
		if (!location.pathname.endsWith('/')) {
			const path = location.pathname.endsWith('.html')
				? location.pathname.slice(0, -'index.html'.length)
				: location.pathname;
			history.replaceState(history.state, '', path + location.search + location.hash);
		}
	}
</script>
